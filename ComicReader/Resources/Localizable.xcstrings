    "%lld comics came back without their files and can't be opened until you import them again.": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld comic came back without its file and can't be opened until you import it again."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld comics came back without their files and can't be opened until you import them again."
                }
              }
            }
          }
        },
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld Comic kam ohne seine Datei zurück und lässt sich erst öffnen, wenn du ihn erneut importierst."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld Comics kamen ohne ihre Dateien zurück und lassen sich erst öffnen, wenn du sie erneut importierst."
                }
              }
            }
          }
        },
        "it": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld fumetto è tornato senza il suo file e non si potrà aprire finché non lo importerai di nuovo."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld fumetti sono tornati senza i loro file e non si potranno aprire finché non li importerai di nuovo."
                }
              }
            }
          }
        }
      }
    },
    "%lld of those comics were already in your library from your comic folder. They're now downloaded.": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "That comic was already in your library from your comic folder. It's now downloaded."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld of those comics were already in your library from your comic folder. They're now downloaded."
                }
              }
            }
          }
        },
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Dieser Comic war schon aus deinem Comic-Ordner in deiner Bibliothek. Jetzt ist er geladen."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld dieser Comics waren schon aus deinem Comic-Ordner in deiner Bibliothek. Jetzt sind sie geladen."
                }
              }
            }
          }
        },
        "it": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Questo fumetto era già nella libreria dalla cartella dei fumetti. Ora è scaricato."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld di questi fumetti erano già nella libreria dalla cartella dei fumetti. Ora sono scaricati."
                }
              }
            }
          }
        }
      }
    },
