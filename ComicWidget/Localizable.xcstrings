    "The comic you read last. Tap to continue where you left off.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Comic, den du zuletzt gelesen hast. Tippe, um dort weiterzulesen, wo du aufgehört hast."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’ultimo fumetto che hai letto. Tocca per riprendere da dove avevi interrotto."
          }
        }
      }
